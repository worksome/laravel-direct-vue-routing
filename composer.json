{
    "name": "worksome/laravel-direct-vue-routing",
    "description": "Add support for mapping Laravel routes directly to Vue components.",
    "keywords": [
        "worksome",
        "laravel",
        "direct-vue-routing"
    ],
    "homepage": "https://github.com/worksome/laravel-direct-vue-routing",
    "license": "MIT",
    "authors": [
        {
            "name": "Owen Voke",
            "email": "owen@worksome.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "canvural/larastan-strict-rules": "^3.0",
        "larastan/larastan": "^3.10",
        "nunomaduro/collision": "^8.1.1",
        "orchestra/testbench": "^10.8 || ^11.0",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1",
        "worksome/coding-style": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Worksome\\DirectVueRouting\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Worksome\\DirectVueRouting\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "lint": "vendor/bin/ecs --fix",
        "test:unit": "vendor/bin/pest -p",
        "test:coverage": "vendor/bin/pest -p --coverage",
        "test:types": "vendor/bin/phpstan analyse",
        "test:style": "vendor/bin/ecs",
        "test": [
            "@test:style",
            "@test:types",
            "@test:unit"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "worksome/coding-style": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Worksome\\DirectVueRouting\\DirectVueRoutingServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
